{
  "name": "project-loop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "powershell -Command \"Start-Process npm -ArgumentList '--prefix backend run dev'; npm --prefix frontend run dev\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "start:frontend": "npm --prefix frontend run start",
    "start:backend": "npm --prefix backend run start",
    "test": "npm --prefix backend test",
    "db:push": "npm --prefix backend run db:push",
    "db:seed": "npm --prefix backend run db:seed"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
