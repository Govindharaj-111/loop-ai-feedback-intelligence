# Database Connection String
# For local SQLite development:
DATABASE_URL="file:./dev.db"

# For production PostgreSQL (Supabase / Neon / AWS RDS):
# DATABASE_URL="postgresql://postgres:your_password@ep-example-123456.us-east-1.aws.neon.tech/project_loop?sslmode=require"

# JWT & Authentication Secrets
JWT_SECRET="project-loop-super-secret-jwt-key-2026-secure"
NEXTAUTH_SECRET="project-loop-super-secret-jwt-key-2026-secure"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Integration — Anthropic Claude API Key
# Keeps keys strictly on server-side. Local vector fallback activates if key is unset or "mock-key".
ANTHROPIC_API_KEY="your-anthropic-claude-api-key"
